# ──────────────────────────────────────────────────────────────
# Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# ── Server ────────────────────────────────────────────────────
# Port the server listens on (default: 3000)
PORT=3000

# ── Admin Dashboard ───────────────────────────────────────────
# Secret token required to access /api/users, /api/updates, etc.
# Change this to a strong random string before deploying.
ADMIN_TOKEN=change_this_to_a_strong_secret

# ── App Store Links ───────────────────────────────────────────
# Set these to enable the App Store / Google Play buttons on the login page.
# If left blank, the buttons will be disabled gracefully (no broken URLs).
APP_STORE_URL=
PLAY_STORE_URL=
